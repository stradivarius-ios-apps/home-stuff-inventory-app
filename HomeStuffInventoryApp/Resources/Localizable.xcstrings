    "settings.restore.error.integrity.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The backup’s integrity check failed. Choose an unchanged backup file. Your inventory was not changed." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Перевірка цілісності резервної копії не пройдена. Виберіть незмінений файл копії. Інвентар не змінено." } }
      }
    },
    "settings.restore.error.integrity.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Backup Was Changed" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Резервну копію змінено" } }
      }
    },
    "settings.restore.error.lowStorage.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "There is not enough local storage for the safety copy and restored inventory. Free space and try again. Your inventory was not changed." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Недостатньо локального місця для страхової копії та відновленого інвентарю. Звільніть місце й спробуйте ще раз. Інвентар не змінено." } }
      }
    },
    "settings.restore.error.lowStorage.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Not Enough Storage" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Недостатньо місця" } }
      }
    },
    "settings.restore.error.malformed.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The backup is malformed or incomplete. Create a new backup and try again. Your inventory was not changed." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Резервна копія пошкоджена або неповна. Створіть нову копію та спробуйте ще раз. Інвентар не змінено." } }
      }
    },
    "settings.restore.error.malformed.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Invalid Backup" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Недійсна резервна копія" } }
      }
    },
    "settings.restore.error.tooComplex.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The backup exceeds supported record, tag, field, or nesting limits. Your inventory was not changed." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Резервна копія перевищує підтримувані обмеження записів, тегів, полів або вкладеності. Інвентар не змінено." } }
      }
    },
    "settings.restore.error.tooComplex.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Backup Too Complex" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Резервна копія надто складна" } }
      }
    },
    "settings.restore.error.newerVersion.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Update Home Stuff Inventory before restoring this newer backup. Your inventory was not changed." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Оновіть Home Stuff Inventory, перш ніж відновлювати цю новішу копію. Інвентар не змінено." } }
      }
    },
    "settings.restore.error.newerVersion.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Newer App Required" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Потрібна новіша версія застосунку" } }
      }
    },
    "settings.restore.error.recovery.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A recovery copy could not be prepared, so restore did not start. Free storage and try again. Your inventory was not changed." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Не вдалося підготувати копію для відновлення, тому заміну не розпочато. Звільніть місце й спробуйте ще раз. Інвентар не змінено." } }
      }
    },
    "settings.restore.error.recovery.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore Couldn’t Start" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Не вдалося почати відновлення" } }
      }
    },
    "settings.restore.error.recoveryRequired.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic recovery could not verify either inventory. Your recovery files were preserved. Restart the app and try again, or contact Support before changing inventory." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Автоматичне відновлення не змогло перевірити жоден інвентар. Файли відновлення збережено. Перезапустіть застосунок і спробуйте ще раз або зверніться до підтримки, перш ніж змінювати інвентар." } }
      }
    },
    "settings.restore.error.recoveryRequired.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Inventory Recovery Required" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Потрібне відновлення інвентарю" } }
      }
    },
    "settings.restore.error.relationships.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The backup contains broken Item, Location, Storage Place, or Category relationships. Your inventory was not changed." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Резервна копія містить пошкоджені зв’язки між речами, локаціями, місцями зберігання або категоріями. Інвентар не змінено." } }
      }
    },
    "settings.restore.error.relationships.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Backup Relationships Are Invalid" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Зв’язки в резервній копії недійсні" } }
      }
    },
    "settings.restore.error.replacement.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The replacement failed and was rolled back. Your original inventory remains unchanged." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Не вдалося виконати заміну, тому зміни скасовано. Початковий інвентар не змінено." } }
      }
    },
    "settings.restore.error.replacement.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Inventory Was Not Restored" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Інвентар не відновлено" } }
      }
    },
    "settings.restore.error.unreadable.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The selected file could not be read. Check its availability and try again. Your inventory was not changed." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Не вдалося прочитати вибраний файл. Перевірте його доступність і спробуйте ще раз. Інвентар не змінено." } }
      }
    },
