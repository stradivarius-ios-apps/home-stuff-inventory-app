    "settings.restore.preflight.replacementExplanation" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This is a replacement, not a merge. All Items, Locations, Storage Places, Categories, and recent-view history currently on this device will be replaced by the exact backup contents. A recovery copy is created first." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Це заміна, а не об’єднання. Усі речі, локації, місця зберігання, категорії та історію недавніх переглядів на цьому пристрої буде замінено точним вмістом копії. Спочатку буде створено копію для відновлення." } }
