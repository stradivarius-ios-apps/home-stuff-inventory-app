    "settings.fileDisclosure.backup.continue" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue to Backup" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Продовжити створення копії" } }
      }
    },
    "settings.fileDisclosure.backup.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The backup contains your complete local inventory, including item details, locations, storage places, notes, tags, dates, and recent item-view history. Home Stuff does not encrypt or password-protect the backup file. After you save it, its protection depends on the destination you choose." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Резервна копія містить увесь локальний інвентар, зокрема дані речей, локації, місця зберігання, нотатки, теги, дати та історію нещодавніх переглядів. Home Stuff не шифрує й не захищає паролем файл резервної копії. Після збереження його захист залежить від вибраного місця призначення." } }
      }
    },
    "settings.fileDisclosure.cancel" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Скасувати" } }
      }
    },
    "settings.fileDisclosure.export.continue" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue to Export" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Продовжити експорт" } }
      }
    },
    "settings.fileDisclosure.export.message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The export may include item names, locations, storage places, categories, quantities, conditions, tags, notes, and dates. Home Stuff does not encrypt or password-protect the exported JSON file. After you save or share it, its protection depends on the destination you choose." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Експорт може містити назви речей, локації, місця зберігання, категорії, кількість, стан, теги, нотатки та дати. Home Stuff не шифрує й не захищає паролем експортований JSON-файл. Після збереження або надсилання його захист залежить від вибраного місця призначення." } }
      }
    },
    "settings.fileDisclosure.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This file is not password-protected" } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Цей файл не захищено паролем" } }
      }
    },
    "settings.introduction.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Locations and Storage Places help you remember where every item lives." } },
        "uk" : { "stringUnit" : { "state" : "translated", "value" : "Локації та місця зберігання допомагають памʼятати, де зберігається кожна річ." } }
      }
    },
    "locations.placeMove.accessRequired.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Moving all items from a Storage Place requires additional access." } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Для переміщення всіх речей із місця зберігання потрібен додатковий доступ." } } } },
    "locations.placeMove.action" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Move Place Contents" } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Перемістити вміст місця" } } } },
    "locations.placeMove.action.hint" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Moves only the items stored directly in this Storage Place." } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Переміщує лише речі, що зберігаються безпосередньо в цьому місці." } } } },
    "locations.placeMove.back" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Back" } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Назад" } } } },
    "locations.placeMove.cancel" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Скасувати" } } } },
    "locations.placeMove.cancelled.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The move was cancelled. No items were changed." } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Переміщення скасовано. Жодну річ не змінено." } } } },
    "locations.placeMove.confirm.action" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Move Items" } }, "uk" : { "stringUnit" : { "state" : "translated", "value" : "Перемістити речі" } } } },
